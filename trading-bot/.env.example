# Schwab developer app credentials — https://developer.schwab.com
# Copy to .env and fill in, or export these in your shell.
SCHWAB_APP_KEY=your-app-key-here
SCHWAB_APP_SECRET=your-app-secret-here

# Must EXACTLY match the callback URL registered on your Schwab app.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
